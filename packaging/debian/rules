#!/usr/bin/make -f
# debhelper rules for qrow

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked

override_dh_auto_install:
	install -Dm755 target/release/qrow \
		$(CURDIR)/debian/qrow/usr/bin/qrow
	# Short alias
	ln -s /usr/bin/qrow \
		$(CURDIR)/debian/qrow/usr/bin/qrw

override_dh_auto_test:
	cargo test --locked

override_dh_auto_clean:
	cargo clean
